# ==========================================
# Terraform Exclusions
# ==========================================
# Local .terraform directories
**/.terraform/

# Terraform state files (In case local runs produce them)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan outputs (Can contain sensitive data)
tfplan
*.tfplan

# Terraform variable files containing secrets
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ==========================================
# Lambda & Build Artifacts
# ==========================================
*.zip
lambda_payload.zip

# ==========================================
# Python Exclusions
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# ==========================================
# Secrets & Local Environment Configs
# ==========================================
.env
!.env.example

# ==========================================
# OS & IDE Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/